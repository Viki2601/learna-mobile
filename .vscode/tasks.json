{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Expo Image Picker",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"install",
				"expo-image-picker"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Profile Changes",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate Profile Feature",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/s",
				"/c",
				"npm run lint && npx tsc --noEmit && npm test -- --runInBand"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Profile Lint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Profile Lint Again",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Profile Typecheck",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recheck Profile Types",
			"type": "shell",
			"command": "npx",
			"args": [
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Profile Tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--",
				"--runInBand"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}